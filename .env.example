# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional connection string for production PostgreSQL (e.g. Cloud SQL, Neon, Supabase).
# If not provided, SellPilot automatically uses its embedded relational PostgreSQL engine.
DATABASE_URL=

# PAYSTACK_SECRET_KEY: Secret key from your Paystack Dashboard (sk_test_... or sk_live_...)
# Used by SellPilot backend to initialize and verify real Nigerian payments (Cards, Bank Transfer, USSD).
PAYSTACK_SECRET_KEY=

# PAYSTACK_PUBLIC_KEY: Public key from your Paystack Dashboard (pk_test_... or pk_live_...)
# Used for client-side checkout components if applicable.
PAYSTACK_PUBLIC_KEY=

# PAYSTACK WEBHOOK URL:
# Configure this endpoint in your Paystack Dashboard > Settings > API Keys & Webhooks:
# https://<YOUR_APP_DOMAIN>/api/payments/paystack/webhook

# ADMIN_EMAIL: Optional custom administrator email (defaults to admin@sellpilot.ng)
ADMIN_EMAIL=

# ADMIN_PASSWORD: Secure administrator password for initial admin setup (required for automatic initial admin creation)
ADMIN_PASSWORD=

# TRANSACTIONAL EMAIL CONFIGURATION (GMAIL SMTP)
# Use a Google App Password (not your regular Gmail password)
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_SECURE=true
GMAIL_SMTP_USER=
GMAIL_SMTP_PASS=
GMAIL_FROM_EMAIL=

# DEMO AUTHENTICATION GATE
# By default, /api/auth/demo is disabled in production (NODE_ENV=production) to prevent unauthorized access.
# Set to 'true' only if demo access is explicitly desired in a production environment.
ENABLE_DEMO_LOGIN=false

# API RATE LIMITING (PHASE 3, STEP 3)
# Global IP-based rate limiting on all /api/* routes (defaults: 500 requests / 15 minutes)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=500
