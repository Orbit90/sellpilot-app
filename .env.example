# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional connection string for production PostgreSQL (e.g. Cloud SQL, Neon, Supabase).
# If not provided, SellPilot automatically uses its embedded relational PostgreSQL engine.
DATABASE_URL=

# PAYSTACK_SECRET_KEY: Secret key from your Paystack Dashboard (sk_test_... or sk_live_...)
# Used by SellPilot backend to initialize and verify real Nigerian payments (Cards, Bank Transfer, USSD).
PAYSTACK_SECRET_KEY=

# PAYSTACK_PUBLIC_KEY: Public key from your Paystack Dashboard (pk_test_... or pk_live_...)
# Used for client-side checkout components if applicable.
PAYSTACK_PUBLIC_KEY=

# PAYSTACK WEBHOOK URL:
# Configure this endpoint in your Paystack Dashboard > Settings > API Keys & Webhooks:
# https://<YOUR_APP_DOMAIN>/api/payments/paystack/webhook

# ADMIN_EMAIL: Optional custom administrator email (defaults to admin@sellpilot.ng)
ADMIN_EMAIL=

# ADMIN_PASSWORD: Optional administrator password for initial setup (defaults to SellPilotAdmin2026!)
ADMIN_PASSWORD=

# TRANSACTIONAL EMAIL CONFIGURATION
# Option 1: Resend (Recommended for Render and modern cloud stacks)
RESEND_API_KEY=
RESEND_FROM_EMAIL="SellPilot <noreply@sellpilot.ng>"

# Option 2: Standard SMTP (SendGrid, Postmark, AWS SES, Brevo, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SellPilot <noreply@sellpilot.ng>"
